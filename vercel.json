{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.jfif",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/verify", "destination": "/verify.html" },
    { "source": "/verify/", "destination": "/verify.html" },
    { "source": "/videos", "destination": "/videos.html" },
    { "source": "/videos/", "destination": "/videos.html" },
    { "source": "/telangana-districts", "destination": "/telangana-districts.html" },
    { "source": "/telangana-districts/", "destination": "/telangana-districts.html" },
    { "source": "/indian-states", "destination": "/indian-states.html" },
    { "source": "/indian-states/", "destination": "/indian-states.html" },
    { "source": "/search", "destination": "/search.html" },
    { "source": "/search/", "destination": "/search.html" },
    { "source": "/reporters", "destination": "/reporters.html" },
    { "source": "/reporters/", "destination": "/reporters.html" },
    { "source": "/info", "destination": "/info.html" },
    { "source": "/info/", "destination": "/info.html" }
  ]
}