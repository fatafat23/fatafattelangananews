# ===== Apache .htaccess (cPanel hosting ke liye) =====
# SEO: clean URLs + 404 + caching + compression + security headers

Options -Indexes

# ---- 404 error page ----
ErrorDocument 404 /404.html

# ---- Clean URLs (extension ke bina) ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^videos/?$ videos.html [L]
  RewriteRule ^telangana-districts/?$ telangana-districts.html [L]
  RewriteRule ^indian-states/?$ indian-states.html [L]
  RewriteRule ^search/?$ search.html [L]
  RewriteRule ^reporters/?$ reporters.html [L]
  RewriteRule ^info/?$ info.html [L]
</IfModule>

# ---- GZIP compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 3600 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Sitemap access ----
<IfModule mod_rewrite.c>
  RewriteRule ^sitemap\.xml$ sitemap.xml [L]
</IfModule>